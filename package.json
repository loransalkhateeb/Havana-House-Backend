{
  "name": "havanahouse-backend",
  "version": "1.0.0",
  "description": "",
  "main": "electron.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "build:frontend": "cd ../POS-system/pos-app && npm run build",
    "copy:frontend": "xcopy /E /I /Y ..\\POS-system\\pos-app\\build .\\public\\frontend",
    "electron:build": "npm run build:frontend && npm run copy:frontend && electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "http-status": "^1.7.4",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.30.1",
    "multer": "^2.1.1",
    "nodemon": "^3.1.14",
    "socket.io": "^4.8.3"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "prisma": "^5.22.0",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.havanahouse.pos",
    "productName": "Havana House POS",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable"
    },
    "asar": false,
    "files": [
      "src/**/*",
      "prisma/**/*",
      "public/**/*",
      "electron.js",
      "package.json",
      "node_modules/**/*",
      "node_modules/.prisma/**/*"
    ],
    "extraFiles": [
      {
        "from": "dev.db",
        "to": "dev.db"
      }
    ]
  }
}
